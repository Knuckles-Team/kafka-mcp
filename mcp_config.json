{
  "mcpServers": {
    "kafka-mcp": {
      "command": "uv",
      "args": [
        "run",
        "kafka-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "condensed",
        "KAFKATOOL": "True",
        "KAFKA_BOOTSTRAP_SERVERS": "localhost:9092",
        "KAFKA_CLUSTER_ID": "",
        "KAFKA_PASSWORD": "",
        "KAFKA_REST_URL": "http://localhost:8082",
        "KAFKA_TOKEN": "",
        "KAFKA_USERNAME": ""
      }
    }
  }
}
