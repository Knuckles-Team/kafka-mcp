{
  "mcpServers": {
    "kafka-mcp": {
      "command": "uv",
      "args": [
        "run",
        "kafka-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "intent",
        "KAFKATOOL": "True",
        "KAFKA_BOOTSTRAP_SERVERS": "localhost:9092",
        "KAFKA_REST_URL": "http://localhost:8082"
      }
    }
  }
}
