{
  "mcpServers": {
    "kafka-mcp": {
      "command": "uv",
      "args": [
        "run",
        "kafka-mcp"
      ],
      "env": {
        "KAFKATOOL": "True",
        "KAFKA_BOOTSTRAP_SERVERS": "localhost:9092",
        "KAFKA_CDCTOOL": "True",
        "KAFKA_CONNECTTOOL": "True",
        "KAFKA_CONNECT_URL": "http://localhost:8083",
        "KAFKA_REST_URL": "http://localhost:8082"
      }
    }
  }
}
